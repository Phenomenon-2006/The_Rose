# Copy this file to ".env" for local tools (backup/restore). NEVER commit ".env".
# On Vercel, add the same names in: Project > Settings > Environment Variables.

# Supabase: Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
# The SECRET key ("service_role" / "secret"). Server only. Never put it in frontend files.
SUPABASE_SERVICE_ROLE_KEY=PASTE_SECRET_KEY_HERE

# Generate the next four values with:  node tools/setup-secrets.js
SESSION_SECRET=PLACEHOLDER_LONG_RANDOM_STRING
PASSWORD_HASH_A=PLACEHOLDER
PASSWORD_HASH_B=PLACEHOLDER
PASSWORD_HASH_TEST=PLACEHOLDER

# Names shown above messages (Persian is fine)
NAME_A=PLACEHOLDER_NAME_A
NAME_B=PLACEHOLDER_NAME_B
